{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite"
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-jobs",
      "schedule": "0 16 * * *"
    }
  ]
}
