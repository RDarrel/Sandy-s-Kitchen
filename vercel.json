{
  "services": {
    "app": {
      "root": ".",
      "framework": "express"
    },
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-jobs",
      "schedule": "0 16 * * *"
    }
  ]
}
